# ==============================================================================
# E-Commerce SaaS — Local Development Environment Template
# ==============================================================================
# USAGE:
#   1. Copy this file to `.env` (which is gitignored and must NEVER be committed):
#        cp .env.example .env
#   2. Replace every `CHANGE_ME_DEV_ONLY_*` secret with a cryptographically random
#      value (>= 32 characters), for example:
#        python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# PRODUCTION FAIL-CLOSED NOTICE (ARCH-001 / core/config.py):
#   Application startup MUST fail closed when ENVIRONMENT=production if ANY of
#   the following misconfigurations exist:
#     - PAYMENT_SANDBOX_MODE=true
#     - COOKIE_SECURE=false
#     - Wildcard or missing ALLOWED_ORIGINS
#     - Any HMAC/signing secret shorter than 32 chars or still using placeholder text
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 16 (db service + backend SQLAlchemy connection)
# ------------------------------------------------------------------------------
POSTGRES_USER=ecom_dev
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY_POSTGRES_PASSWORD
POSTGRES_DB=ecom_dev

# Inside Docker Compose (`api` and `migrate`), use hostname `db` on port 5432.
# When running pytest or alembic directly on the host, override host to `localhost`.
DATABASE_URL=postgresql+psycopg://ecom_dev:CHANGE_ME_DEV_ONLY_POSTGRES_PASSWORD@db:5432/ecom_dev

# ------------------------------------------------------------------------------
# Backend Runtime, Cookies & CORS
# ------------------------------------------------------------------------------
# Allowed values: development | test | staging | production
ENVIRONMENT=development

# Set to `true` in staging/production behind HTTPS. `false` is dev-only over HTTP.
COOKIE_SECURE=false

# Comma-separated explicit origins (no trailing slashes, no `*` wildcard in prod).
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Cryptographic Secrets (DEV PLACEHOLDERS — REPLACE BEFORE RUNNING)
# WARNING: Minimum 32 characters each. Never reuse production keys locally and
#          never commit `.env` or real secrets to version control.
# ------------------------------------------------------------------------------
CSRF_HMAC_SECRET=CHANGE_ME_DEV_ONLY_MIN_32_CHARS_CSRF_HMAC_SECRET
GUEST_ORDER_HMAC_SECRET=CHANGE_ME_DEV_ONLY_MIN_32_CHARS_GUEST_ORDER_SECRET
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_DEV_ONLY_MIN_32_CHARS_PAYMENT_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# Sandbox Payments & Session Lifecycle
# ------------------------------------------------------------------------------
# Sandbox simulation trigger (/api/v1/payments/sandbox/*/simulate).
# MUST be `false` whenever ENVIRONMENT=production.
PAYMENT_SANDBOX_MODE=true

# Server-backed HTTP-only session TTL in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# ------------------------------------------------------------------------------
# Server-Authoritative Shipping & Tax Rules (Baseline integer minor units)
# ------------------------------------------------------------------------------
# Free shipping threshold in cents (10000 = $100.00 USD)
FREE_SHIPPING_THRESHOLD_CENTS=10000

# Standard flat shipping fee in cents when subtotal < threshold (1000 = $10.00 USD)
STANDARD_SHIPPING_CENTS=1000

# Flat tax rate in basis points (800 = 8.00%)
TAX_RATE_BPS=800

# ------------------------------------------------------------------------------
# Next.js Frontend URLs
# ------------------------------------------------------------------------------
# Browser-facing API base URL (baked at Next.js build time via Docker build arg).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-side (SSR) API base URL used inside the `web` container across Compose DNS.
INTERNAL_API_BASE_URL=http://api:8000/api/v1
